# ═══════════════════════════════════════════════════════════
#  ShopNav — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# Port the server listens on.
# On Render/Railway this is set automatically — don't override it.
PORT=3000

# Absolute path to the SQLite database file.
# Leave empty to use the default (project root: shopnav.db).
# On Render with a Persistent Disk mounted at /var/data, set this to:
#   DB_PATH=/var/data/shopnav.db
DB_PATH=

# Node environment: "development" | "production"
NODE_ENV=development
